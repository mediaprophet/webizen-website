        "aboutTitle": {
          "value": "A world to explore.\nAn ecosystem to understand.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "aboutCopy": {
          "value": "This revised review scene is a continuous, authored natural landscape. The landscape presentation uses Three.js; the local demonstration host executes the current Synth/QualiaDB operations and returns their actual resources and receipts. The terrain is also imported and sealed as a native .10d asset through Synth.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "aboutGraph": {
          "value": "The public website graph is published as a genuine .q42 volume and verified by the native QualiaDB reader. Declared-purpose anchors and typed relationships select the route; Vibe packages the resulting sequence. Authentication, private graph views, delegation and contestability remain separate host integration work.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "aboutLimits": {
          "value": "The landscape and helix are artistic explanatory representations, not ecological or medical measurements. The existing demo index preserves all 202 source routes; those pages have individual qualification requirements.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "supportIntro": {
          "value": "Choose the purpose and support that fit this visit. Preferences stay in this browser. Explore the same entities through a different sequence or presentation.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "riverBody": {
          "value": "A river connects geology, soil, plants and human life. Information becomes useful when it remains connected to a place, a question and the conditions under which it was gathered. Change the bounded terrain brush below to run a real production operation and inspect its output.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "canopyBody": {
          "value": "A tree is part of biological, ecological, cultural and informational relationships. Switch the relationship lens to see how these connections cross the landscape. The world is an authored model; the linked biology, geometry and knowledge demonstrations expose their own inputs and scope.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "commonsBody": {
          "value": "Sharing knowledge should support people and their purposes. Try a synthetic community request below. The actual QualiaDB deontic evaluator processes the authored norms, and the local host returns the summary only when the selected norm permits it. Individual records are never included in the response.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "atelierBody": {
          "value": "A sound, a model or a written work carries human intention. Synth connects a production recipe to its output, so a creator can inspect, repeat and share the work. Generate a tone, listen deliberately, then inspect the source and package.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "observatoryBody": {
          "value": "How can we inspect information about the physical world? Change the amplitude of a synthetic emitter, compile an electromagnetic field, and inspect its magnitude preview. The current preview is greyscale. This is a model estimate, not a sensor measurement or a complete Maxwell solver.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "biologyBody": {
          "value": "Understanding a living body requires relationships across scale, purpose, evidence and uncertainty. The garden helix is a spatial invitation into the existing anatomy and biological demonstrations, not a biological dataset in itself.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "fieldStrength": {
          "value": "Electric field amplitude (V/m)",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "field-studio": {
          "value": "The field studio",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "field-studioShort": {
          "value": "Living, working and making from a campsite.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        },
        "field-studioBody": {
          "value": "A gold 2012–13 Volkswagen Passat wagon with a streamlined charcoal roof box, a 1980 Jayco wind-up camper, two three-panel solar arrays and one two-panel array on the ground, and a Starlink Mini on the camper roof. This campsite reflects the circumstances in which this ecosystem has been developed: living, working, making and staying connected. The vehicle and camper are authored interpretations of the described models.",
          "language": "en-AU",
          "review_state": "draft",
          "reviewer": null
        }
