requires [capability("capability.invoke")];
let mesh = capability.invoke("hypermedia.manifold.import_mesh", {input: "catchment-600m-lod0.glb", format: "glb"});
let native = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
    mesh: mesh,
    topology: false,
    spatial_index: true,
    camera_position: [180.0, 145.0, 220.0],
    camera_target: [0.0, 12.0, 0.0],
    camera_up: [0.0, 1.0, 0.0]
});
let mut asset = {files: [{key: "catchment-600m-lod0.10d", resource: native}]};
