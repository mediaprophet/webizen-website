requires [capability("capability.invoke")];
let mesh = capability.invoke("hypermedia.manifold.import_mesh", {input: "catchment-600m-water.glb", format: "glb"});
let native = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
    mesh: mesh,
    topology: false,
    spatial_index: true,
    camera_position: [120.0, 160.0, 180.0],
    camera_target: [0.0, 0.24, 0.0],
    camera_up: [0.0, 1.0, 0.0]
});
let mut asset = {files: [{key: "catchment-600m-water.10d", resource: native}]};
