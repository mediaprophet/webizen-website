requires [capability("capability.invoke")];
let world={id:"canopy--timber",asset:"canopy",material:50,instances:[{id:"canopy",rotation:[0.0,0.0,0.0,1.0],scale:[0.45,0.45,0.45],translation:[-17.0,2.981431,6.0]}],input:"world.glb"};
let geometry=capability.invoke("hypermedia.manifold.import_mesh",{input:world.input,format:"glb"});
