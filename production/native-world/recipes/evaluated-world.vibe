pure fn river_ring(z: f64) -> List {
    let x = river_x(z);
    let w = 3.2 + 0.7 * math.sin(z*0.08);
    return [[x-w,0.08,z],[x+w,0.08,z],[x+w,0.025,z],[x-w,0.025,z]];
}

