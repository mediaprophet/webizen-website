requires [capability("capability.invoke")];
let world={id:"terrain--high-ridge",asset:"terrain",material:0,instances:[{id:"terrain",translation:[0,0,0],rotation:[0,0,0,1],scale:[1,1,1]}],input:"world.glb"};
let geometry=capability.invoke("hypermedia.manifold.import_mesh",{input:world.input,format:"glb"});
let native=capability.invoke("hypermedia.manifold.compile_10d_pbr",{mesh:geometry});
let mut asset={files:[{key:"terrain--high-ridge.10d",resource:native}]};