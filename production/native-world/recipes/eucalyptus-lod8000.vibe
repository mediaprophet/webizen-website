requires [capability("capability.invoke")];
let world={id:"eucalyptus-lod8000",asset:"eucalyptus",material:0,instances:[{id:"eucalyptus-lod8000",translation:[0,0,0],rotation:[0,0,0,1],scale:[1,1,1]}],input:"world.glb"};
let geometry=capability.invoke("hypermedia.manifold.import_mesh",{input:world.input,format:"glb"});
