requires [capability("capability.invoke")];
let geometry=capability.invoke("hypermedia.manifold.import_mesh",{input:"batch.glb",format:"glb"});
let native=capability.invoke("hypermedia.manifold.compile_10d_pbr",{mesh:geometry,topology:false,spatial_index:true});
let mut asset={files:[{key:"ecology-grass-mid-2.10d",resource:native}]};