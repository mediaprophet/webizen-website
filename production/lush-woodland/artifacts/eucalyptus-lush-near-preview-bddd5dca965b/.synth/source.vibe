requires [capability("capability.invoke")];
let g=capability.invoke("hypermedia.manifold.import_mesh",{input:"tree.obj",format:"obj"});
let n=capability.invoke("hypermedia.manifold.compile_10d_pbr",{mesh:g,topology:false,spatial_index:false});
let mut asset={files:[{key:"eucalyptus-lush-near.10d",resource:n}]};