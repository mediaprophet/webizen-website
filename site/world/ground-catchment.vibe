requires [capability("capability.invoke")];

// WR-01 soil mesh. Metre frame shared with the resident catchment:
// origin at the basin centre, +Y up, x and z in [-300, 300], unit is the metre.
// The GLB is the 600 m triangle mesh (floodplain silt, leaf litter, sandstone,
// granite, pebble, wet bank, and the campsite pad). The host samples
// catchment-soil.bin; it does not evaluate this Vibe in the frame loop.
let mesh = capability.invoke("hypermedia.manifold.import_mesh", {input: "catchment-ground.glb", format: "glb"});
let native = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
    mesh: mesh,
    topology: false,
    spatial_index: true,
    camera_position: [-46.0, 16.0, 58.0],
    camera_target: [-20.0, 5.2, 28.0],
    camera_up: [0.0, 1.0, 0.0]
});
let mut asset = {files: [{key: "catchment-ground.10d", resource: native}]};
