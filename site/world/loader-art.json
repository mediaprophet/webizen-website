 "marks": [
  {
   "id": "hand",
   "era": "c. 40,000 years ago",
   "title": "A hand on the wall",
   "line": "Someone pressed a palm to stone and blew ochre around it. I was here."
  },
  {
   "id": "wedges",
   "era": "c. 3,200 BCE",
   "title": "Marks that remember",
   "line": "Reeds pressed into clay, and speech outlived the speaker."
  },
  {
   "id": "wave",
   "era": "Before history, and always",
   "title": "Song",
   "line": "Breath shaped into pattern, carried from voice to voice."
  },
  {
   "id": "spiral",
   "era": "c. 300 BCE",
   "title": "Proportion",
   "line": "We found the shapes inside the shell, the seed head and the storm."
  },
  {
   "id": "glyph",
   "era": "1450",
   "title": "Moveable type",
   "line": "Letters set free to travel, and ideas began to multiply."
  },
  {
   "id": "orbit",
   "era": "1957",
   "title": "Reaching outward",
   "line": "A small sphere circled the Earth, and the sky became a place."
  },
  {
   "id": "helix",
   "era": "1953",
   "title": "Reading life",
   "line": "Two strands, and the grammar of every living thing."
  },
  {
   "id": "network",
   "era": "1989",
   "title": "A web of people",
   "line": "Documents linked to documents, and minds to minds."
  },
  {
   "id": "world",
   "era": "Now",
   "title": "Your turn",
   "line": "A living world, made with care, waiting for what you will make."
  }
