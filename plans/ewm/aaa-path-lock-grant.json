  "handshake": {
    "A00": {
      "exclusive_paths": [
        "plans/aaa-overhaul/**"
      ],
      "action": "Wave 0 ewm-integrator applies ewm_path_lock as the A00 handshake. A00-A27 identifiers stay."
    },
    "A02": {
      "exclusive_paths": [
        "data/catalogue/**",
        "data/acquisition/**",
        "data/publications/**"
      ],
      "ewm_must_not": "Do not put EWM GIS, consent, frames, or first-paint under A02 trees. Copy (do not edit) the Canberra DEM publication into /packages/ in EWM-03."
    },
    "A03": {
      "exclusive_paths": [
        "native/contracts/**",
        "instruments/contracts/**",
        "schemas/aaa/**"
      ],
      "ewm_must_not": "EWM catalog lives in schemas/ewm/**. Do not create native/contracts/** for EWM."
    },
    "A06": {
      "remaining_exclusive_after_grant": [
        "native/world-host/** except EWM exclusive modules and integrator parents listed below",
        "world/runtime/**"
      ],
      "on_integrator_parents": "A06 may read; writes go through the EWM integrator while EWM PRs are in flight. A06 keeps world/runtime/** and remaining non-stream world-host modules."
    }
  },
  "a06_carve_outs": [
    "native/world-host/src/runtime/stream/**",
    "native/world-host/src/runtime/gis_join.rs",
    "native/world-host/src/runtime/gis_ingest.rs",
    "native/world-host/src/runtime/ocs_frames.rs",
    "native/world-host/src/runtime/consent.rs",
    "native/world-host/src/runtime/ui/download.rs"
  ],
