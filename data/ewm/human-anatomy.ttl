                 joint:ankle_l ,
                 joint:toe_l ,
                 joint:hip_r ,
                 joint:knee_r ,
                 joint:ankle_r ,
                 joint:toe_r ;
    ewm:hasIkChain ik:leg_l , ik:leg_r , ik:arm_l , ik:arm_r ;
    ewm:hasEmfProfile emf:cardiac , emf:neural , emf:respiratory .

<did:q42:taxon:homo-sapiens>
    a dwc:Taxon , dcat:Dataset ;
    owl:sameAs <urn:qualia:taxon:homo_sapiens> , <did:q42:taxon:homo_sapiens> ;
    ewm:slug "homo-sapiens" ;
    dwc:scientificName "Homo sapiens Linnaeus, 1758" ;
    dwc:vernacularName "Human"@en ;
    rdfs:label "Human (Homo sapiens)"@en ;
    dwc:kingdom "Animalia" ;
    dwc:phylum "Chordata" ;
    dwc:class "Mammalia" ;
    dwc:order "Primates" ;
    dwc:family "Hominidae" ;
    ewm:taxonOntologyUrl "/intenteco/homo-sapiens/ontology/taxon.ttl" ;
    ewm:biomechanicsJsonUrl "/intenteco/homo-sapiens/ontology/biomechanics.json" ;
    odrl:hasPolicy "SocialPermissiveCommons" ;
    ewm:statureM 1.74 ;
