    ewm:comStandingM 0.96 ;
    ewm:comSeatedM 0.78 .

# ============================================================================
# Three Anatomical Layers (FMA + UBERON)
# ============================================================================

layer:osteology
    a ewm:AnatomicalLayer , fma:23881 , uberon:0001434 ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:layerIndex 1 ;
    ewm:layerId "osteology" ;
    ewm:fmaCurie "FMA:23881" ;
    ewm:uberonCurie "UBERON:0001434" ;
    rdfs:label "Layer 1 — Osteology"@en ;
    ewm:subsystemsSummary "Cranium (FMA:50185/UBERON:0003128), Mandible (FMA:52748/UBERON:0001684), Cervical/Thoracic/Lumbar/Sacral Spine (FMA:24138,24139,24140,16202), Ribcage+Sternum (FMA:7480,7485), Clavicles+Scapulae (FMA:13321,13394), Pelvis (FMA:9578), Humeri/Radii/Ulnae/Hands (FMA:13303,23463,23466,9712), Femora/Patellae/Tibiae/Fibulae/Feet (FMA:24474,24485,24476,24479,9664)" ;
    ewm:corticalBoneYoungsModulusGPa 17.5 ;
    ewm:corticalBoneBmdMgCm3 1150.0 ;
    ewm:trabecularBvTv 0.24 .

layer:myology_viscera
    a ewm:AnatomicalLayer , fma:72954 , uberon:0001630 , uberon:0002075 ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:layerIndex 2 ;
    ewm:layerId "myology_and_viscera" ;
    ewm:fmaCurie "FMA:72954" ;
    ewm:uberonCurie "UBERON:0001630" ;
    ewm:visceraUberonCurie "UBERON:0002075" ;
    rdfs:label "Layer 2 — Myology & Major Viscera"@en ;
    ewm:visceraSummary "4-chambered Heart (FMA:7088/UBERON:0000948, 60-75 bpm), Lungs (FMA:7195/UBERON:0002048), Diaphragm (FMA:13296/UBERON:0001103), Brain/CNS (FMA:50801/UBERON:0000955)" ;
    ewm:myologySummary "Trapezius (FMA:9604), Deltoids (FMA:9603), Pectoralis major (FMA:13427), Latissimus dorsi (FMA:13345), Rectus abdominis (FMA:9629), Gluteals (FMA:22312), Quadriceps (FMA:22432), Hamstrings (FMA:75148), Gastrocnemius/Soleus (FMA:22541,22542), Biceps/Triceps (FMA:37402,37441)" .

layer:integument_anthropometry
    a ewm:AnatomicalLayer , fma:72979 , uberon:0002199 ;
