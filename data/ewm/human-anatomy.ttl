<https://webizen.au/catalog/human-anatomy>
    a <https://webizen.au/catalog/AnatomyCatalog> , dcat:Dataset ;
    ewm:schema "webizen.human-anatomy/v1" ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:layerCount 3 ;
    ewm:skl2JointCount 28 ;
    ewm:hasLayer layer:osteology ,
                 layer:myology_viscera ,
                 layer:integument_anthropometry ;
    ewm:hasJoint joint:pelvis_root ,
                 joint:spine_lumbar ,
                 joint:spine_thoracic ,
                 joint:spine_cervical ,
                 joint:neck ,
                 joint:head ,
                 joint:jaw ,
                 joint:ribcage_sternum ,
