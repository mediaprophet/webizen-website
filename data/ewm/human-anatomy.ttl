# ============================================================================
# IK Chains & Seated Driver Posture
# ============================================================================

ik:leg_l a ewm:IkChain ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:solver "two_bone_ik" ;
    ewm:rootJoint joint:hip_l ; ewm:midJoint joint:knee_l ; ewm:endJoint joint:ankle_l ;
    ewm:upperLengthM 0.4301 ; ewm:lowerLengthM 0.4105 .

ik:leg_r a ewm:IkChain ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:solver "two_bone_ik" ;
    ewm:rootJoint joint:hip_r ; ewm:midJoint joint:knee_r ; ewm:endJoint joint:ankle_r ;
    ewm:upperLengthM 0.4301 ; ewm:lowerLengthM 0.4105 .

ik:arm_l a ewm:IkChain ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:solver "two_bone_ik" ;
    ewm:rootJoint joint:shoulder_l ; ewm:midJoint joint:elbow_l ; ewm:endJoint joint:wrist_l ;
    ewm:upperLengthM 0.2650 ; ewm:lowerLengthM 0.2250 ;
    ewm:reachMode "steering_wheel_10_oclock_and_inspect" .

ik:arm_r a ewm:IkChain ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:solver "two_bone_ik" ;
    ewm:rootJoint joint:shoulder_r ; ewm:midJoint joint:elbow_r ; ewm:endJoint joint:wrist_r ;
    ewm:upperLengthM 0.2650 ; ewm:lowerLengthM 0.2250 ;
    ewm:reachMode "steering_wheel_2_oclock_and_inspect" .

human:posture_seated_driver a ewm:PostureProfile ;
    ewm:forTaxon <did:q42:taxon:homo-sapiens> ;
    ewm:hipFlexionDeg 95.0 ;
    ewm:kneeFlexionDeg 65.0 ;
    ewm:comSeatedM 0.78 ;
    ewm:steeringWheelGrip "10_and_2_oclock" ;
    rdfs:label "Seated Driver Posture (Hip 95 deg, Knee 65 deg, Hands on Steering Wheel Rim)"@en .
